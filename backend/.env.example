# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_NAME=Agri Analyst Q&A System
APP_VERSION=1.0.0

# Set to False in production
DEBUG=False

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# IMPORTANT: Update with your deployed frontend URL for production
# Format: Comma-separated list of origins (no spaces)
CORS_ORIGINS=https://agri-analyst.netlify.app,http://localhost:5173,http://localhost:3000

# =============================================================================
# LLM CONFIGURATION - Google Gemini
# =============================================================================
# REQUIRED: Get your API key from https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Model selection: gemini-2.5-flash (faster) or gemini-1.5-pro (more accurate)
GEMINI_MODEL=gemini-2.5-flash

# Temperature (0.0-1.0): Lower = more focused, Higher = more creative
GEMINI_TEMPERATURE=0.3

# Maximum tokens in response
GEMINI_MAX_TOKENS=8192

# =============================================================================
# EMBEDDING MODEL CONFIGURATION
# =============================================================================
# Local embedding model from HuggingFace
EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================================================
# VECTOR DATABASE CONFIGURATION
# =============================================================================
# IMPORTANT FOR VERCEL DEPLOYMENT:
# ChromaDB with local persistence won't work on Vercel (serverless/stateless)
# 
# OPTION 1: Use ChromaDB locally/testing (default below)
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=agri_datasets

# OPTION 2: Use Pinecone (recommended for production on Vercel)
# Uncomment these lines and comment out CHROMA_* above:
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_ENVIRONMENT=your_pinecone_environment
# PINECONE_INDEX_NAME=agri-analyst

# =============================================================================
# LANGSMITH CONFIGURATION (Optional - for debugging/tracing)
# =============================================================================
# Get API key from https://smith.langchain.com/
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=agri_analyst
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_V1_PREFIX=/api/v1

# =============================================================================
# DATA.GOV.IN API CONFIGURATION
# =============================================================================
# REQUIRED: Get your API key from https://data.gov.in/
GOV_API_KEY=your_data_gov_api_key_here
