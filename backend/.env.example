# Application Configuration
APP_NAME=Agri Analyst Q&A System
APP_VERSION=1.0.0
DEBUG=True

# LLM Configuration - Google Gemini
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=8192

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agri_analyst

# ChromaDB Vector Store
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=agri_datasets

# LangSmith (Optional - for tracing and debugging)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=agri-analyst

# Data.gov.in API Configuration
DATA_GOV_BASE_URL=https://api.data.gov.in/resource

# Agriculture Ministry API Keys (Required)
AGRI_CROP_PRODUCTION_API_KEY=your_agriculture_crop_api_key_here
AGRI_HORTICULTURE_API_KEY=your_horticulture_api_key_here
AGRI_LIVESTOCK_API_KEY=your_livestock_api_key_here

# India Meteorological Department (IMD) API Keys (Required)
IMD_RAINFALL_API_KEY=your_imd_rainfall_api_key_here
IMD_TEMPERATURE_API_KEY=your_imd_temperature_api_key_here
IMD_CLIMATE_API_KEY=your_imd_climate_api_key_here

# Other Ministry API Keys (Optional)
LAND_RESOURCES_API_KEY=your_land_resources_api_key_here
WATER_RESOURCES_API_KEY=your_water_resources_api_key_here

# API Settings
API_REQUEST_TIMEOUT=30
API_CACHE_TTL=3600
API_MAX_RETRIES=3

# API Configuration
API_V1_PREFIX=/api/v1

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60

# Query Configuration
MAX_QUERY_RESULTS=1000
DEFAULT_QUERY_LIMIT=100
