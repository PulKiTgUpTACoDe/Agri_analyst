# Application Configuration
APP_NAME=Agri Analyst Q&A System
APP_VERSION=2.0.0
DEBUG=True
LOG_LEVEL=INFO

CORS_ORIGINS="https://agri-analyst.netlify.app, https://agri-analyst-zc9g.vercel.app, http://localhost:5173"

# LLM Configuration - Google Gemini
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=8192

# data.gov.in API Key (get from https://data.gov.in)
GOV_API_KEY=your-data-gov-api-key

# Cache Settings
CACHE_MAX_SIZE=500
CACHE_DEFAULT_TTL=3600

# LangSmith (Optional - for tracing and debugging)
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_PROJECT=agri_analyst
